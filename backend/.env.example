# Copy to .env for local dev. See src/config/env.ts for the schema that
# actually validates these at startup (the app refuses to start if a
# required one is missing).

# --- Required ---
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
# Any non-empty string works today - required by env.ts but not currently
# read anywhere else in the codebase (no JWT-based auth exists yet).
JWT_SECRET=replace-with-any-random-string

# --- Redis (needed for the real BullMQ job queues to run at all) ---
# Set REDIS_URL if your provider (e.g. Railway) gives you a single
# connection string - it takes precedence. Otherwise set REDIS_HOST/PORT.
REDIS_URL=redis://default:password@host:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- AI features (optional - AI classification/chat/error-analysis are
# silently skipped or degraded without this, everything else still works) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# --- Optional, all have working defaults ---
PORT=3001
API_VERSION=v1
LOG_LEVEL=info
