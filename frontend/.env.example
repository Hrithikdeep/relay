# Copy to .env.local for local dev.

# --- Required ---
# Base URL of the real backend API (no trailing /v1 - lib/api.ts adds that).
NEXT_PUBLIC_API_URL=https://your-backend.example.com
# Sent as x-api-key on every request. This is a real API key created via
# the dashboard's API Keys page (or the seeded default in dev).
NEXT_PUBLIC_API_KEY=relay_sk_live_...

# --- Temporary whole-app password gate (see src/proxy.ts) ---
# Server-only (no NEXT_PUBLIC_ prefix - never shipped to the browser).
# If unset, the gate is disabled entirely (no login required).
DEMO_ACCESS_PASSWORD=choose-a-shared-password
# Email the login form requires (defaults to demo@relay.dev if unset).
# DEMO_ACCESS_EMAIL=demo@relay.dev
# Set to "true" to show the "DEMO ACCESS" box (email + password, with a
# one-click fill) on /login. This renders the password in the page HTML for
# anyone who can load /login, so only enable it for a public demo password.
# DEMO_SHOW_CREDENTIALS=true
